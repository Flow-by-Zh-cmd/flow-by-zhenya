# Несекретные настройки для хостинга. Переменные окружения в панели хостинга имеют приоритет над этим файлом.
# НЕ пишите сюда BOT_TOKEN и открытый DATABASE_URL — репозиторий может быть публичным.

# Адрес приложения на хостинге (https://...), включает режим вебхука. На Render можно не заполнять.
WEBHOOK_BASE_URL=
# Строка подключения к БД, зашифрованная токеном бота (python secretbox.py encrypt 'postgresql://...')
DATABASE_URL_ENC=
OWNER_IDS=
CANCEL_HOURS=12
TZ_NAME=Asia/Yekaterinburg
STUDIO_NAME=Flow by Zhenya
STUDIO_ADDRESS=адрес студии уточните у тренера
CURRENCY=RUB
